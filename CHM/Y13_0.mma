(* ---- cell 1 ---- *)
unitaryDefect[X_] := Module[{d = Dimensions[X][[1]], R, T}, T = Table[0, {d}, {d}]; R = Flatten[Table[Flatten[ReplacePart[T, {i -> X[[i]]*Conjugate[X[[j]]], j -> (-X[[i]])*Conjugate[X[[j]]]}]], {i, 1, d - 1}, {j, i + 1, d}], 1]; (d - 1)^2 - MatrixRank[Join[Re[R], Im[R]]]]

(* ---- cell 2 ---- *)
complexHadamardQ[X_, tolerance_] := Module[{d, fn1, fn2}, d = Dimensions[X][[1]]; fn1 = Norm[X . ConjugateTranspose[X] - d*IdentityMatrix[d], "Frobenius"]; fn2 = Norm[Abs[X] - ConstantArray[1, {d, d}], "Frobenius"]; If[fn1 < tolerance && fn2 < tolerance, Return[True], Return[False]]; ]

(* ---- cell 3 ---- *)
[Clear[a, b, c, d, e, f]], Hold[Null], Hold[nle = {a^2 + b^2 + c^2 + d^2 + e^2 + f^2 + 1/a^2 + 1/b^2 + 1/c^2 + 1/d^2 + 1/e^2 + 1/f^2 + 1 == 0, a/c + b/a + c/b + d/f + e/d + f/e + c/a + a/b + b/c + f/d + d/e + e/f + 1 == 0, a*c + a*b + b*c + d*f + d*e + e*f + 1/(a*c) + 1/(a*b) + 1/(b*c) + 1/(d*f) + 1/(d*e) + 1/(e*f) + 1 == 0, a*e + b*f + c*d + d/a + e/b + f/c + 1/(a*e) + 1/(b*f) + 1/(c*d) + a/d + b/e + c/f + 1 == 0, a*d + b*e + c*f + a/e + b/f + c/d + 1/(a*d) + 1/(b*e) + 1/(c*f) + e/a + f/b + d/c + 1 == 0, a*f + b*d + c*e + d/b + e/c + f/a + 1/(a*f) + 1/(b*d) + 1/(c*e) + b/d + c/e + a/f + 1 == 0}; ], Hold[Null], Hold[s = NSolve[nle, {a, b, c, d, e, f}]; ]

