({a0, a1, a2, a3, a4, a5, a6, a7} = {-16, 256, -96, -896, -696, -96, 56, 16}; )*(F2 = (4*a6 - a7^2)/8; )*(F1 = (a5 - a7*F2)/2; )*(F0 = (a4 - a7*F1 - F2^2)/2; )*(F3 = (a3 - a7*F0 - 2*F1*F2)/2; )*(F4 = a2 - F1^2 - 2*F0*F2; )*(F5 = (a1 - 2*F0*F1)/2; )*(F6 = a0 - F0^2; )*(F7 = (16*F2 - a7^2)/16; )*(F8 = (a7*F3 - 2*F4)/2; )*(F9 = (a7*F8 + 8*F5 - 4*F3*F7)/(a7*F7 - 4*F1); )*(F10 = -((a7*F3^2 + 4*F3*F8)/(a7*F7 - 4*F1)); )*(F11 = (4*F3^3)/(a7*F7 - 4*F1); )*(F12 = (4*a7^2*F0 - 16*F1^2 - 8*a7*F3)/a7^2; )*(F13 = (16*F3^2 + 64*F1*F5 - 4*a7^2*F6 - 32*a7*F0*F3)/a7^2; )*(F14 = (32*a7*F3*F6 + 64*F0*F3^2 - 64*F5^2)/a7^2; )*(F15 = -((64*F3^2*F6)/a7^2); )*(N[{F0, F1, F2, F3, F4, F5, F6, F7, F8, F9, F10, F11, F12, F13, F14, F15}]; )*(h0 = (F11*F12 - F15 - F9*F11)/(F10 + F9*F12 - F13 - F9^2); )*(h1 = (F11 + F10*F12 - F14 - F9*F10)/(F10 + F9*F12 - F13 - F9^2); )*(h2 = h0*h1 + F11 - F9*h0; )*(h3 = h0 + F9*h1 - F10 - h1^2; )*(g = (1/2)*(-h1 - Sqrt[-4*h0 + h1^2]); )*(c21 = F2 + Sqrt[g]; )*(c22 = F2 - Sqrt[g]; )*(c01 = F0 + g/2 + ((8*F5 - 4*F1*g)/(8*F3 - 2*a7*g))*Sqrt[g]; )*(c02 = F0 + g/2 - ((8*F5 - 4*F1*g)/(8*F3 - 2*a7*g))*Sqrt[g]; )*(c11 = F1 + (a7/4)*Sqrt[g] - F3/Sqrt[g]; )*(c12 = F1 - (a7/4)*Sqrt[g] + F3/Sqrt[g]; )*{F0, F1, F2, F3, F4, F5, F6, F7, F8, F9, F10, F11, F12, F13, F14, F15}*FullSimplify[{a7/2, c21, c11, c01}]*FullSimplify[{a7/2, c22, c12, c02}]

